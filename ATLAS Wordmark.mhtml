div.wordmark-ui-div .ui-block span { position: relative; float: left; width=
: 33%; cursor: pointer; user-select: none; opacity: 0.5; text-align: center=
; text-decoration: none; }

div.wordmark-ui-div .ui-block span#random-button { width: 50%; }

div.wordmark-ui-div .ui-block span#dark-mode { width: 50%; }

body.dark div.wordmark-ui-div .ui-block span#dark-mode { opacity: 0.8; text=
-decoration: underline; }

div.wordmark-ui-div .ui-block .lock.active { opacity: 0.8; text-decoration:=
 underline; }

div.wordmark-ui-div .ui-block span:hover, div.wordmark-ui-div .ui-block .lo=
ck:hover { opacity: 1; }

