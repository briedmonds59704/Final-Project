4; }

div.wordmark-ui-div #wordmark-ui-1 { left: 0px; width: 24.1%; }

div.wordmark-ui-div #wordmark-ui-2 { left: 57.6%; width: 24.1%; }

div#download-div { position: relative; float: left; width: 100%; text-align=
: center; margin-top: 10em; user-select: none; display: flex; justify-conte=
nt: center; flex-basis: 100%; flex-wrap: wrap; }

div#download-div a { color: black; width: 100%; margin-bottom: 3em; }

