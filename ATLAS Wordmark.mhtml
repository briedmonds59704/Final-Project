d: white; }

body.dark { color: white; background: black; }

div#container { position: relative; float: left; padding: 0px; margin: 0px;=
 width: 100vw; height: 100vh; display: flex; justify-content: center; align=
-items: center; flex-basis: 100%; flex-wrap: wrap; }

div#wordmark-div { width: 70vw; }

div#wordmark-svg-div { position: relative; float: left; width: 100%; }

